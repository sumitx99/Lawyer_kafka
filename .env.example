# Generate .env with: python3 scripts/setup_env.py
# Host-run applications use loopback. Future Compose apps use the service names.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_DB=lexaior_rag
POSTGRES_USER=lexaior
POSTGRES_PASSWORD=change-me
DB_DRIVER=asyncpg
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSION=1024

VALKEY_HOST=127.0.0.1
VALKEY_PORT=6380
VALKEY_PASSWORD=change-me

KAFKA_PORT=9093
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9093
# Inside Compose: kafka:19092
KAFKA_TOPIC_UPLOADED=doc.uploaded
KAFKA_TOPIC_PARSED=doc.parsed
KAFKA_TOPIC_QUERY=query.requested

STORAGE_PROVIDER=seaweedfs
STORAGE_PORT=8333
STORAGE_ENDPOINT_URL=http://127.0.0.1:8333
STORAGE_ACCESS_KEY=change-me
STORAGE_SECRET_KEY=change-me
STORAGE_BUCKET=rag-documents
STORAGE_REGION=us-east-1

OLLAMA_PORT=11434
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_MODEL=qwen3:4b
LLM_API_KEY=ollama

# Deferred until the core RAG pipeline works.
REFERENCE_EXTRACTION_ENABLED=false

# CPU parsing worker (first PDF conversion downloads local model weights).
PARSE_TIMEOUT_SECONDS=480
PARSE_LEASE_SECONDS=120
PARSE_MAX_ATTEMPTS=3
PARSE_MAX_PAGES=500
PARSER_THREADS=4
PARSER_FORCE_OCR=false
STANDARDIZATION_GROUP_ID=lexaior-standardization-v1

# Indexing worker: heading-aware chunks -> BGE-M3 (1024 dims) -> Postgres. Weights: make embedding-model
INDEXING_GROUP_ID=lexaior-indexing-v1
CHUNK_TARGET_TOKENS=400
CHUNK_MAX_TOKENS=512
EMBEDDING_DEVICE=auto
EMBEDDING_BATCH_SIZE=16
EMBEDDING_MAX_LENGTH=1024
INDEX_TIMEOUT_SECONDS=900
INDEX_LEASE_SECONDS=180
INDEX_MAX_ATTEMPTS=3

# Recovery: expired leases (crashed workers) and documents stuck without an in-flight event.
SWEEP_INTERVAL_SECONDS=60
SWEEP_STUCK_SECONDS=900
SWEEP_BATCH_SIZE=50

# Folder pipeline (design doc): topics, fair queue limits per stage, leases, retries.
KAFKA_TOPIC_STANDARDIZATION=STNDZ_TOPIC
KAFKA_TOPIC_CSV_PARQUET=CSV_PARQUET_TOPIC
KAFKA_TOPIC_MARKDOWN=RAG_MARKDOWN_TOPIC
KAFKA_TOPIC_IMAGE=RAG_IMAGE_TOPIC
KAFKA_TOPIC_METACLASSIFIER=METACLASSIFIER_TOPIC
STANDARDIZATION_MAX_WORKERS=2
STANDARDIZATION_MAX_PER_USER=1
MARKDOWN_MAX_WORKERS=2
MARKDOWN_MAX_PER_USER=1
IMAGE_MAX_WORKERS=1
IMAGE_MAX_PER_USER=1
METACLASSIFIER_MAX_WORKERS=1
METACLASSIFIER_MAX_PER_USER=1
PARQUET_MAX_WORKERS=2
PARQUET_MAX_PER_USER=1
STAGE_LEASE_SECONDS=180
STAGE_TIMEOUT_SECONDS=1800
STAGE_MAX_ATTEMPTS=3
STAGE_RETRY_BASE_SECONDS=30
STAGE_POLL_SECONDS=30
STAGE_STUCK_SECONDS=900
STANDARDIZATION_STUCK_SECONDS=1800

# Local chart/diagram/photo understanding. Install weights with: make vision-model
VISION_ENABLED=true
VISION_MODEL=qwen3-vl:4b-instruct
VISION_TIMEOUT_SECONDS=180
VISION_MAX_IMAGES=32
VISION_MAX_IMAGE_SIDE=1280
# Metaclassifier: model, document passage budget (tokens), model context window and call timeout.
METACLASSIFIER_MODEL=qwen3-vl:4b-instruct
METACLASSIFIER_INPUT_TOKENS=6000
METACLASSIFIER_CONTEXT_TOKENS=16384
METACLASSIFIER_TIMEOUT_SECONDS=600

# Office conversion and CSV limits.
LIBREOFFICE_PATH=/Applications/LibreOffice.app/Contents/MacOS/soffice
CONVERSION_TIMEOUT_SECONDS=180
CSV_MAX_ROWS=1000000
CSV_MAX_COLUMNS=1000
